@using JewelryStore.Services.DTOs.User
@model VerifyPhoneDto
@{
    ViewData["Title"] = "تایید شماره موبایل";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid #C9C0AA;
        padding: 0.75rem 0;
        font-family: var(--hs-sans);
        color: var(--hs-ink);
        text-align: center;
        font-size: 2rem;
        letter-spacing: 0.3em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-input:focus {
            outline: none;
            border-bottom: 2px solid var(--hs-forest);
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: #142A1F;
        }
</style>

<div class="min-h-screen flex items-center justify-center" style="background-color: #FBF7F0; padding: 48px 24px;">
    <div class="w-full max-w-md">
        <!-- عنوان -->
        <div class="text-center mb-12">
            <div class="text-4xl text-[#C2A878] mb-4">
                <i class="fas fa-sms"></i>
            </div>
            <h1 class="hs-display text-3xl text-[#1A1F1B]">تایید شماره موبایل</h1>
            <p class="hs-sans text-[#5C625C] mt-2">
                کد ۵ رقمی ارسال شده به
                <span class="font-semibold text-[#1A1F1B]">@Model.PhoneNumber</span>
                را وارد کنید
            </p>
        </div>

        <!-- فرم تایید -->
        <div class="bg-white border border-[#E3DCC9] rounded-[4px] p-8">
            <form asp-action="VerifyPhone" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PhoneNumber" />

                <div asp-validation-summary="ModelOnly" class="text-[#8C3A36] hs-sans text-sm mb-4"></div>

                <!-- کد تایید -->
                <div class="mb-8">
                    <label asp-for="Code" class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-4 text-center">
                        کد تایید
                    </label>
                    <input asp-for="Code" class="hs-input" placeholder="•••••" maxlength="5" dir="ltr" />
                    <span asp-validation-for="Code" class="hs-sans text-xs text-[#8C3A36] block mt-2 text-center"></span>
                </div>

                <!-- دکمه تایید -->
                <button type="submit" class="btn-hs-primary w-full py-3 text-sm">
                    تایید شماره موبایل
                </button>
            </form>

            <!-- ارسال مجدد کد -->
            <div class="text-center mt-6">
                <form asp-action="ResendVerificationCode" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                    <button type="submit" class="hs-sans text-sm text-[#5C625C] hover:text-[#1F3D2E] hs-transition">
                        <i class="fas fa-redo ml-1"></i> ارسال مجدد کد
                    </button>
                </form>
                <a asp-action="Register" class="hs-sans text-sm text-[#5C625C] hover:text-[#1F3D2E] hs-transition block mt-2">
                    <i class="fas fa-arrow-right ml-1"></i> بازگشت به ثبت‌نام
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}