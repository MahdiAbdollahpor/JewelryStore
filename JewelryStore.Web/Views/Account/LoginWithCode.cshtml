@{
    ViewData["Title"] = "ورود با کد یکبارمصرف";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-forest-deep: #142A1F;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid #C9C0AA;
        padding: 0.75rem 0;
        font-family: var(--hs-sans);
        color: var(--hs-ink);
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-input:focus {
            outline: none;
            border-bottom: 2px solid var(--hs-forest);
        }

        .hs-input::placeholder {
            color: #8E928D;
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: var(--hs-forest-deep);
        }
</style>

<div class="min-h-screen flex items-center justify-center" style="background-color: #FBF7F0; padding: 48px 24px;">
    <div class="w-full max-w-md">
        <!-- عنوان -->
        <div class="text-center mb-12">
            <a asp-action="Index" asp-controller="Product"
               class="hs-display text-4xl font-bold text-[#1F3D2E] tracking-[-0.02em] block">
                جواهری
            </a>
            <h1 class="hs-display text-3xl mt-6 text-[#1A1F1B]">ورود با کد یکبارمصرف</h1>
            <p class="hs-sans text-[#5C625C] mt-2">کد تایید به شماره موبایل شما ارسال خواهد شد</p>
        </div>

        <!-- فرم -->
        <div class="bg-white border border-[#E3DCC9] rounded-[4px] p-8">
            <form asp-action="RequestLoginCode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-6">
                    <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                        شماره موبایل
                    </label>
                    <input type="text" name="phoneNumber" class="hs-input" placeholder="09xxxxxxxxx" dir="ltr" />
                </div>

                <button type="submit" class="btn-hs-primary w-full py-3 text-sm">
                    <i class="fas fa-sms ml-1"></i> دریافت کد تایید
                </button>
            </form>

            <div class="text-center mt-6">
                <a asp-action="Login" class="hs-sans text-sm text-[#5C625C] hover:text-[#1F3D2E] hs-transition">
                    <i class="fas fa-arrow-right ml-1"></i> بازگشت به ورود با رمز عبور
                </a>
            </div>
        </div>
    </div>
</div>