@using JewelryStore.Services.DTOs.User
@model UserProfileDto
@{
    ViewData["Title"] = "پروفایل کاربری";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-forest-deep: #142A1F;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-card {
        background: #FFFFFF;
        border: 1px solid var(--hs-outline);
        border-radius: 4px;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid #C9C0AA;
        padding: 0.75rem 0;
        font-family: var(--hs-sans);
        color: var(--hs-ink);
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-input:focus {
            outline: none;
            border-bottom: 2px solid var(--hs-forest);
        }

        .hs-input::placeholder {
            color: #8E928D;
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: var(--hs-forest-deep);
        }

    .btn-hs-outline {
        background: transparent;
        border: 1px solid var(--hs-forest);
        color: var(--hs-forest);
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-outline:hover {
            background: var(--hs-forest);
            color: #FBF7F0;
        }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--hs-outline);
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        color: var(--hs-ink-muted);
        font-size: 14px;
    }

    .info-value {
        font-weight: 500;
        color: var(--hs-ink);
    }
</style>

<div class="min-h-screen" style="background-color: #FBF7F0; color: #1A1F1B;">

    <!-- ✅ هدر صفحه -->
    <div class="border-b border-[#E3DCC9] py-20">
        <div class="max-w-[1440px] mx-auto px-6 md:px-12">
            <h1 class="hs-display text-4xl md:text-5xl text-[#1A1F1B]">
                <i class="far fa-user-circle text-[#C2A878] text-3xl ml-4"></i>
                پروفایل کاربری
            </h1>
            <p class="hs-sans text-lg text-[#5C625C] mt-2">
                @Model.FullName ?? @Model.Username
            </p>
        </div>
    </div>

    <!-- ✅ محتوای اصلی -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- اطلاعات کاربر -->
            <div class="lg:col-span-2">
                <div class="hs-card p-8">
                    <h3 class="hs-display text-2xl text-[#1A1F1B] mb-6">اطلاعات شخصی</h3>

                    <div class="info-row">
                        <span class="info-label">نام کاربری</span>
                        <span class="info-value">@Model.Username</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">نام کامل</span>
                        <span class="info-value">@(Model.FullName ?? "-")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">شماره موبایل</span>
                        <span class="info-value">@Model.PhoneNumber</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">آدرس</span>
                        <span class="info-value">@(Model.Address ?? "-")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">نقش</span>
                        <span class="info-value">@(Model.Role == "Admin" ? "مدیر" : "کاربر")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">تاریخ ثبت‌نام</span>
                        <span class="info-value">@Model.CreatedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">وضعیت تایید</span>
                        <span class="info-value">
                            @if (Model.IsPhoneVerified)
                            {
                                <span class="text-[#16A34A]">✓ تایید شده</span>
                            }
                            else
                            {
                                <span class="text-[#D97706]">⚠ تایید نشده</span>
                            }
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">وضعیت حساب</span>
                        <span class="info-value">
                            @if (Model.IsActive)
                            {
                                <span class="text-[#16A34A]">فعال</span>
                            }
                            else
                            {
                                <span class="text-[#DC2626]">غیرفعال</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- فرم ویرایش و تغییر رمز -->
            <div class="space-y-8">
                <!-- ویرایش پروفایل -->
                <div class="hs-card p-6">
                    <h3 class="hs-display text-xl text-[#1A1F1B] mb-4">ویرایش اطلاعات</h3>

                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                                نام کامل
                            </label>
                            <input type="text" name="FullName" class="hs-input" value="@Model.FullName" placeholder="نام کامل خود را وارد کنید" />
                        </div>

                        <div class="mb-4">
                            <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                                آدرس
                            </label>
                            <input type="text" name="Address" class="hs-input" value="@Model.Address" placeholder="آدرس خود را وارد کنید" />
                        </div>

                        <button type="submit" class="btn-hs-primary w-full py-3 text-sm">
                            <i class="fas fa-save ml-1"></i> ذخیره تغییرات
                        </button>
                    </form>
                </div>

                <!-- تغییر رمز عبور -->
                <div class="hs-card p-6">
                    <h3 class="hs-display text-xl text-[#1A1F1B] mb-4">تغییر رمز عبور</h3>

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                                رمز عبور فعلی
                            </label>
                            <input type="password" name="CurrentPassword" class="hs-input" placeholder="رمز عبور فعلی" />
                        </div>

                        <div class="mb-4">
                            <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                                رمز عبور جدید
                            </label>
                            <input type="password" name="NewPassword" class="hs-input" placeholder="رمز عبور جدید" />
                        </div>

                        <button type="submit" class="btn-hs-outline w-full py-3 text-sm">
                            <i class="fas fa-key ml-1"></i> تغییر رمز عبور
                        </button>
                    </form>
                </div>

                <!-- خروج -->
                <form asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full py-3 text-sm text-[#8C3A36] border border-[#8C3A36] rounded-[2px] hover:bg-[#8C3A36] hover:text-white hs-transition">
                        <i class="fas fa-sign-out-alt ml-1"></i> خروج از حساب کاربری
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}