@using JewelryStore.Services.DTOs.User
@model RegisterDto
@{
    ViewData["Title"] = "ثبت‌نام";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid #C9C0AA;
        padding: 0.75rem 0;
        font-family: var(--hs-sans);
        color: var(--hs-ink);
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-input:focus {
            outline: none;
            border-bottom: 2px solid var(--hs-forest);
        }

        .hs-input::placeholder {
            color: #8E928D;
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: #142A1F;
        }
</style>

<div class="min-h-screen flex items-center justify-center" style="background-color: #FBF7F0; padding: 48px 24px;">
    <div class="w-full max-w-md">
        <!-- لوگو و عنوان -->
        <div class="text-center mb-12">
            <a asp-action="Index" asp-controller="Product"
               class="hs-display text-4xl font-bold text-[#1F3D2E] tracking-[-0.02em] block">
                جواهری
            </a>
            <h1 class="hs-display text-3xl mt-6 text-[#1A1F1B]">ثبت‌نام</h1>
            <p class="hs-sans text-[#5C625C] mt-2">به جمع دوستداران هنر و جواهر بپیوندید</p>
        </div>

        <!-- فرم ثبت‌نام -->
        <div class="bg-white border border-[#E3DCC9] rounded-[4px] p-8">
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-[#8C3A36] hs-sans text-sm mb-4"></div>

                <!-- نام کاربری -->
                <div class="mb-6">
                    <label asp-for="Username" class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                        نام کاربری
                    </label>
                    <input asp-for="Username" class="hs-input" placeholder="نام کاربری خود را وارد کنید" />
                    <span asp-validation-for="Username" class="hs-sans text-xs text-[#8C3A36] block mt-1"></span>
                </div>

                <!-- نام کامل -->
                <div class="mb-6">
                    <label asp-for="FullName" class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                        نام و نام خانوادگی
                    </label>
                    <input asp-for="FullName" class="hs-input" placeholder="نام و نام خانوادگی خود را وارد کنید" />
                    <span asp-validation-for="FullName" class="hs-sans text-xs text-[#8C3A36] block mt-1"></span>
                </div>

                <!-- شماره موبایل -->
                <div class="mb-6">
                    <label asp-for="PhoneNumber" class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                        شماره موبایل
                    </label>
                    <input asp-for="PhoneNumber" class="hs-input" placeholder="09xxxxxxxxx" dir="ltr" />
                    <span asp-validation-for="PhoneNumber" class="hs-sans text-xs text-[#8C3A36] block mt-1"></span>
                </div>

                <!-- رمز عبور -->
                <div class="mb-6">
                    <label asp-for="Password" class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C] block mb-2">
                        رمز عبور
                    </label>
                    <input asp-for="Password" type="password" class="hs-input" placeholder="رمز عبور خود را وارد کنید" />
                    <span asp-validation-for="Password" class="hs-sans text-xs text-[#8C3A36] block mt-1"></span>
                </div>

                <!-- دکمه ثبت‌نام -->
                <button type="submit" class="btn-hs-primary w-full py-3 text-sm">
                    ایجاد حساب کاربری
                </button>
            </form>

            <!-- لینک ورود -->
            <div class="text-center mt-6">
                <p class="hs-sans text-sm text-[#5C625C]">
                    قبلاً حساب کاربری دارید؟
                    <a asp-action="Login" class="text-[#1F3D2E] hover:text-[#3D6650] hs-transition font-medium">
                        وارد شوید
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}