@using JewelryStore.Services.DTOs.Cart

@model CartDto
@{
    ViewData["Title"] = "سبد خرید";
}

<div class="container my-4">
    <h2 class="mb-4">🛒 سبد خرید</h2>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3">سبد خرید شما خالی است</h4>
            <a asp-action="Index" asp-controller="Product" class="btn btn-primary mt-3">
                <i class="bi bi-arrow-right"></i> ادامه خرید
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <!-- لیست آیتم‌های سبد خرید -->
                <div class="cart-items">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card mb-3 cart-item" data-item-id="@item.Id">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <img src="@(item.ProductImage ?? "/images/no-image.png")"
                                             class="img-fluid rounded" alt="@item.ProductName" />
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="mb-1">@item.ProductName</h6>
                                        @if (!string.IsNullOrEmpty(item.VariantName))
                                        {
                                            <small class="text-muted">تنوع: @item.VariantName</small>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group input-group-sm">
                                            <button class="btn btn-outline-secondary update-quantity" data-change="-1">-</button>
                                            <input type="number" class="form-control text-center item-quantity"
                                                   value="@item.Quantity" min="1" max="@item.MaxOrderQuantity"
                                                   data-item-id="@item.Id" />
                                            <button class="btn btn-outline-secondary update-quantity" data-change="1">+</button>
                                        </div>
                                        @if (!item.IsInStock)
                                        {
                                            <small class="text-danger d-block">موجودی کافی نیست</small>
                                        }
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <span class="fw-bold">@item.TotalPrice.ToString("N0") تومان</span>
                                        @if (item.DiscountAmount > 0)
                                        {
                                            <small class="text-muted d-block">(@item.DiscountAmount% تخفیف)</small>
                                        }
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <button class="btn btn-danger btn-sm remove-item" data-item-id="@item.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="Index" asp-controller="Product" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-right"></i> ادامه خرید
                    </a>
                    <button class="btn btn-outline-danger" id="clearCartBtn">
                        <i class="bi bi-trash"></i> خالی کردن سبد خرید
                    </button>
                </div>
            </div>

            <!-- خلاصه سبد خرید -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">خلاصه سبد خرید</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>تعداد آیتم‌ها:</span>
                            <span id="cartItemCount">@Model.TotalItemsCount</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>جمع کل:</span>
                            <span id="cartSubTotal">@Model.SubTotal.ToString("N0") تومان</span>
                        </div>
                        @if (Model.TotalDiscount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>تخفیف:</span>
                                <span id="cartDiscount">-@Model.TotalDiscount.ToString("N0") تومان</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-bold">قابل پرداخت:</span>
                            <span class="fw-bold text-primary" id="cartTotal">@Model.TotalPrice.ToString("N0") تومان</span>
                        </div>
                        <a href="#" class="btn btn-success w-100" id="checkoutBtn">
                            <i class="bi bi-credit-card"></i> تسویه حساب
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // به‌روزرسانی تعداد آیتم
        document.querySelectorAll('.item-quantity').forEach(input => {
            input.addEventListener('change', async function() {
                const itemId = this.dataset.itemId;
                const quantity = parseInt(this.value);
                await updateCartItem(itemId, quantity);
            });
        });

        // دکمه‌های + و -
        document.querySelectorAll('.update-quantity').forEach(btn => {
            btn.addEventListener('click', async function() {
                const input = this.closest('.input-group').querySelector('.item-quantity');
                const change = parseInt(this.dataset.change);
                const newValue = parseInt(input.value) + change;
                if (newValue >= 1) {
                    input.value = newValue;
                    await updateCartItem(input.dataset.itemId, newValue);
                }
            });
        });

        // حذف آیتم
        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', async function() {
                if (confirm('آیا از حذف این آیتم اطمینان دارید؟')) {
                    const itemId = this.dataset.itemId;
                    await removeCartItem(itemId);
                }
            });
        });

        // خالی کردن سبد خرید
        document.getElementById('clearCartBtn').addEventListener('click', async function() {
            if (confirm('آیا از خالی کردن سبد خرید اطمینان دارید؟')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Cart/ClearCart';
                form.innerHTML = `<input name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]').value}" />`;
                document.body.appendChild(form);
                form.submit();
            }
        });

        // تابع به‌روزرسانی آیتم
        async function updateCartItem(itemId, quantity) {
            try {
                const response = await fetch('/Cart/UpdateQuantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ cartItemId: itemId, quantity: quantity })
                });

                const result = await response.json();
                if (result.success) {
                    // به‌روزرسانی UI
                    const cartItem = result.cartItem;
                    const itemElement = document.querySelector(`.cart-item[data-item-id="${itemId}"]`);
                    if (itemElement) {
                        const totalSpan = itemElement.querySelector('.fw-bold');
                        if (totalSpan) {
                            totalSpan.textContent = cartItem.totalPrice.toLocaleString() + ' تومان';
                        }
                    }
                    // به‌روزرسانی خلاصه
                    document.getElementById('cartItemCount').textContent = result.itemCount || 0;
                    if (result.total) {
                        document.getElementById('cartTotal').textContent = result.total.toLocaleString() + ' تومان';
                    }
                    // به‌روزرسانی ویجت
                    updateCartWidget();
                } else {
                    alert(result.message);
                    // بازگرداندن مقدار قبلی
                    location.reload();
                }
            } catch (error) {
                alert('خطا در ارتباط با سرور');
                location.reload();
            }
        }

        // تابع حذف آیتم
        async function removeCartItem(itemId) {
            try {
                const response = await fetch(`/Cart/RemoveItem?id=${itemId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();
                if (result.success) {
                    // حذف آیتم از DOM
                    const itemElement = document.querySelector(`.cart-item[data-item-id="${itemId}"]`);
                    if (itemElement) {
                        itemElement.remove();
                    }
                    // به‌روزرسانی خلاصه
                    document.getElementById('cartItemCount').textContent = result.itemCount || 0;
                    if (result.total) {
                        document.getElementById('cartTotal').textContent = result.total.toLocaleString() + ' تومان';
                    }
                    // به‌روزرسانی ویجت
                    updateCartWidget();

                    // اگر سبد خرید خالی شد، صفحه را رفرش کن
                    if (document.querySelectorAll('.cart-item').length === 0) {
                        location.reload();
                    }
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('خطا در ارتباط با سرور');
            }
        }

        // به‌روزرسانی ویجت سبد خرید
        async function updateCartWidget() {
            try {
                const response = await fetch('/Cart/CartWidget');
                const data = await response.json();
                document.querySelector('#cart-item-count').textContent = data.itemCount;
                document.querySelector('#cart-total').textContent = data.total;
            } catch (error) {
                console.error('Error updating cart widget:', error);
            }
        }
    </script>
}