@using JewelryStore.Services.DTOs.Cart
@model CartDto
@{
    ViewData["Title"] = "کلکسیون من";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-forest-deep: #142A1F;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-ink-subtle: #8E928D;
        --hs-outline: #E3DCC9;
        --hs-outline-strong: #C9C0AA;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-card {
        background: #FFFFFF;
        border: 1px solid var(--hs-outline);
        border-radius: 4px;
    }

    .hs-input {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--hs-outline-strong);
        padding: 0.5rem 0;
        font-family: var(--hs-sans);
        color: var(--hs-ink);
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-input:focus {
            outline: none;
            border-bottom: 2px solid var(--hs-forest);
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: var(--hs-forest-deep);
        }

    .btn-hs-outline {
        background: transparent;
        border: 1px solid var(--hs-forest);
        color: var(--hs-forest);
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-outline:hover {
            background: var(--hs-forest);
            color: #FBF7F0;
        }
</style>

<div class="min-h-screen" style="background-color: #FBF7F0; color: #1A1F1B;">

    <!-- ✅ هدر صفحه -->
    <div class="border-b border-[#E3DCC9] py-20">
        <div class="max-w-[1440px] mx-auto px-6 md:px-12">
            <h1 class="hs-display text-4xl md:text-5xl text-[#1A1F1B]">
                <i class="fas fa-shopping-bag text-[#C2A878] text-3xl ml-4"></i>
                کلکسیون من
            </h1>
            <p class="hs-sans text-lg text-[#5C625C] mt-2">
                @Model.TotalItemsCount اثر در کلکسیون شما
            </p>
        </div>
    </div>

    <!-- ✅ محتوای اصلی -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-16">
        @if (!Model.Items.Any())
        {
            <!-- حالت خالی -->
            <div class="text-center py-24">
                <i class="fas fa-gem text-6xl text-[#C2A878] block mb-6 opacity-30"></i>
                <h3 class="hs-display text-3xl text-[#1A1F1B] mb-4">کلکسیون شما خالی است</h3>
                <p class="hs-sans text-[#5C625C] mb-8">هنوز اثری به کلکسیون خود اضافه نکرده‌اید.</p>
                <a asp-action="Index" asp-controller="Product" class="btn-hs-primary px-8 py-3 text-sm inline-block">
                    <i class="fas fa-arrow-right ml-2"></i> کشف آثار
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- لیست آیتم‌ها -->
                <div class="lg:col-span-2 space-y-6">
                    @foreach (var item in Model.Items)
                    {
                        <div class="hs-card overflow-hidden group cart-item" data-item-id="@item.Id">
                            <div class="flex flex-col sm:flex-row gap-6 p-6">
                                <!-- تصویر -->
                                <div class="w-full sm:w-32 h-32 flex-shrink-0 bg-[#ECE4D2] overflow-hidden">
                                    <img src="@(item.ProductImage ?? "/images/no-image.png")"
                                         class="w-full h-full object-cover group-hover:scale-[1.02] hs-transition duration-[480ms]"
                                         alt="@item.ProductName" />
                                </div>

                                <!-- اطلاعات -->
                                <div class="flex-1 flex flex-col justify-between">
                                    <div>
                                        <a asp-action="Details" asp-controller="Product" asp-route-slug="@item.ProductId"
                                           class="hs-display text-xl text-[#1A1F1B] hover:text-[#1F3D2E] hs-transition">
                                            @item.ProductName
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.VariantName))
                                        {
                                            <p class="hs-sans text-sm text-[#8E928D] mt-1">
                                                <i class="fas fa-tag ml-1"></i> @item.VariantName
                                            </p>
                                        }
                                    </div>

                                    <div class="flex items-center gap-6 mt-4 pt-4 border-t border-[#E3DCC9]">
                                        <!-- تعداد -->
                                        <div class="flex items-center gap-3">
                                            <label class="hs-sans text-xs uppercase tracking-[0.18em] text-[#5C625C]">تعداد</label>
                                            <div class="flex items-center border border-[#E3DCC9] rounded-[2px]">
                                                <button class="update-quantity w-8 h-8 flex items-center justify-center text-[#5C625C] hover:text-[#1A1F1B] hs-transition" data-change="-1">-</button>
                                                <input type="number" class="item-quantity w-12 h-8 text-center bg-transparent border-x border-[#E3DCC9] text-sm tabular-nums focus:outline-none"
                                                       value="@item.Quantity" min="1" max="@item.MaxOrderQuantity" data-item-id="@item.Id" />
                                                <button class="update-quantity w-8 h-8 flex items-center justify-center text-[#5C625C] hover:text-[#1A1F1B] hs-transition" data-change="1">+</button>
                                            </div>
                                        </div>

                                        <!-- قیمت -->
                                        <div class="mr-auto text-left">
                                            <p class="hs-sans text-lg font-semibold tabular-nums text-[#1F3D2E]">
                                                @item.TotalPrice.ToString("N0") <span class="text-xs font-normal text-[#5C625C]">تومان</span>
                                            </p>
                                            @if (item.DiscountAmount > 0)
                                            {
                                                <p class="hs-sans text-xs text-[#8E928D]">
                                                    <i class="fas fa-tag ml-1"></i> @item.DiscountAmount% تخفیف
                                                </p>
                                            }
                                        </div>

                                        <!-- حذف -->
                                        <button class="remove-item text-[#8E928D] hover:text-[#8C3A36] hs-transition" data-item-id="@item.Id">
                                            <i class="fas fa-trash-alt text-lg"></i>
                                        </button>
                                    </div>

                                    @if (!item.IsInStock)
                                    {
                                        <p class="hs-sans text-xs text-[#A87B3D] mt-2">
                                            <i class="fas fa-exclamation-triangle ml-1"></i> موجودی این اثر به پایان رسیده است
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- خلاصه کلکسیون -->
                <div class="lg:col-span-1">
                    <div class="bg-[#F5EFE3] border border-[#E3DCC9] rounded-[4px] p-8 sticky top-8">
                        <h6 class="hs-display text-2xl text-[#1A1F1B] mb-8">خلاصه کلکسیون</h6>

                        <div class="space-y-4">
                            <div class="flex justify-between hs-sans text-sm">
                                <span class="text-[#5C625C]">تعداد آثار</span>
                                <span id="cartItemCount" class="tabular-nums font-medium">@Model.TotalItemsCount</span>
                            </div>
                            <div class="flex justify-between hs-sans text-sm border-b border-[#E3DCC9] pb-4">
                                <span class="text-[#5C625C]">جمع کل</span>
                                <span id="cartSubTotal" class="tabular-nums font-medium">@Model.SubTotal.ToString("N0") تومان</span>
                            </div>
                            @if (Model.TotalDiscount > 0)
                            {
                                <div class="flex justify-between hs-sans text-sm text-[#4A7C59]">
                                    <span>تخفیف</span>
                                    <span id="cartDiscount">-@Model.TotalDiscount.ToString("N0") تومان</span>
                                </div>
                            }
                            <div class="flex justify-between hs-sans text-lg font-semibold pt-4 border-t border-[#E3DCC9]">
                                <span class="text-[#1A1F1B]">قابل پرداخت</span>
                                <span id="cartTotal" class="text-[#1F3D2E] tabular-nums">@Model.TotalPrice.ToString("N0") تومان</span>
                            </div>
                        </div>

                        <div class="mt-8 space-y-3">
                            <a asp-action="Checkout" class="btn-hs-primary w-full py-3 text-sm block text-center">
                                <i class="fas fa-credit-card ml-2"></i> تکمیل سفارش
                            </a>
                            <a asp-action="Index" asp-controller="Product" class="btn-hs-outline w-full py-3 text-sm block text-center">
                                <i class="fas fa-arrow-right ml-2"></i> ادامه کشف آثار
                            </a>
                            <button id="clearCartBtn" class="w-full py-2 text-xs hs-sans text-[#8E928D] hover:text-[#8C3A36] hs-transition">
                                <i class="fas fa-trash-alt ml-1"></i> خالی کردن کلکسیون
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // به‌روزرسانی تعداد آیتم
        document.querySelectorAll('.item-quantity').forEach(input => {
            input.addEventListener('change', async function() {
                const itemId = this.dataset.itemId;
                const quantity = parseInt(this.value);
                if (quantity < 1) {
                    this.value = 1;
                    return;
                }
                await updateCartItem(itemId, quantity);
            });
        });

        // دکمه‌های + و -
        document.querySelectorAll('.update-quantity').forEach(btn => {
            btn.addEventListener('click', async function() {
                const input = this.closest('.flex').querySelector('.item-quantity');
                const change = parseInt(this.dataset.change);
                const newValue = parseInt(input.value) + change;
                if (newValue >= 1) {
                    input.value = newValue;
                    await updateCartItem(input.dataset.itemId, newValue);
                }
            });
        });

        // حذف آیتم
        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', async function() {
                if (confirm('آیا از حذف این اثر از کلکسیون خود اطمینان دارید؟')) {
                    const itemId = this.dataset.itemId;
                    await removeCartItem(itemId);
                }
            });
        });

        // خالی کردن کلکسیون
        document.getElementById('clearCartBtn')?.addEventListener('click', async function() {
            if (confirm('آیا از خالی کردن کلکسیون خود اطمینان دارید؟')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Cart/ClearCart';
                form.innerHTML = `<input name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}" />`;
                document.body.appendChild(form);
                form.submit();
            }
        });

        // تابع به‌روزرسانی آیتم
        async function updateCartItem(itemId, quantity) {
            try {
                const response = await fetch('/Cart/UpdateQuantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ cartItemId: itemId, quantity: quantity })
                });

                const result = await response.json();
                if (result.success) {
                    // به‌روزرسانی UI
                    const cartItem = result.cartItem;
                    const itemElement = document.querySelector(`.cart-item[data-item-id="${itemId}"]`);
                    if (itemElement) {
                        const totalSpan = itemElement.querySelector('.font-semibold.tabular-nums');
                        if (totalSpan) {
                            totalSpan.textContent = cartItem.totalPrice.toLocaleString() + ' تومان';
                        }
                    }
                    // به‌روزرسانی خلاصه
                    document.getElementById('cartItemCount').textContent = result.itemCount || 0;
                    document.getElementById('cartTotal').textContent = (result.total || 0) + ' تومان';
                    // به‌روزرسانی ویجت
                    if (typeof updateCartWidget === 'function') updateCartWidget();
                } else {
                    alert(result.message);
                    location.reload();
                }
            } catch (error) {
                alert('خطا در ارتباط با سرور');
                location.reload();
            }
        }

        // تابع حذف آیتم
        async function removeCartItem(itemId) {
            try {
                const response = await fetch(`/Cart/RemoveItem?id=${itemId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });

                const result = await response.json();
                if (result.success) {
                    // حذف آیتم از DOM
                    const itemElement = document.querySelector(`.cart-item[data-item-id="${itemId}"]`);
                    if (itemElement) {
                        itemElement.remove();
                    }
                    // به‌روزرسانی خلاصه
                    document.getElementById('cartItemCount').textContent = result.itemCount || 0;
                    document.getElementById('cartTotal').textContent = (result.total || 0) + ' تومان';
                    // به‌روزرسانی ویجت
                    if (typeof updateCartWidget === 'function') updateCartWidget();

                    // اگر کلکسیون خالی شد، صفحه را رفرش کن
                    if (document.querySelectorAll('.cart-item').length === 0) {
                        location.reload();
                    }
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('خطا در ارتباط با سرور');
            }
        }
    </script>
}