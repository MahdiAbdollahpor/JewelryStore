@{
    ViewData["Title"] = "تکمیل سفارش";
}

<div class="min-h-screen flex items-center justify-center" style="background-color: #FBF7F0;">
    <div class="max-w-2xl w-full mx-4 p-12 bg-white border border-[#E3DCC9] rounded-[4px]">
        <div class="text-center">
            <i class="fas fa-credit-card text-4xl text-[#C2A878] mb-4 block"></i>
            <h1 class="font-['Cormorant_Garamond'] text-4xl text-[#1A1F1B] mb-4">تکمیل سفارش</h1>
            <p class="font-['Vazirmatn'] text-[#5C625C] mb-8">
                این صفحه به درگاه پرداخت متصل خواهد شد.
            </p>
            <div class="flex gap-4 justify-center">
                <a asp-action="Index" class="px-6 py-2 border border-[#1F3D2E] text-[#1F3D2E] rounded-[2px] text-sm uppercase tracking-[0.12em] hover:bg-[#1F3D2E] hover:text-white transition-all">
                    بازگشت به کلکسیون
                </a>
                <a href="#" class="px-6 py-2 bg-[#1F3D2E] text-white rounded-[2px] text-sm uppercase tracking-[0.12em] hover:bg-[#142A1F] transition-all">
                    پرداخت
                </a>
            </div>
        </div>
    </div>
</div>