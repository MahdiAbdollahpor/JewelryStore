@using JewelryStore.Services.DTOs.Wishlist
@model IEnumerable<WishlistItemDto>
@{
    ViewData["Title"] = "علاقه‌مندی‌ها";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-forest-deep: #142A1F;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-ink-subtle: #8E928D;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-card {
        background: #FFFFFF;
        border: 1px solid var(--hs-outline);
        border-radius: 4px;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

        .hs-card:hover {
            box-shadow: 0 8px 32px rgba(20, 42, 31, 0.08);
            transform: translateY(-2px);
        }

    .btn-hs-outline {
        background: transparent;
        border: 1px solid var(--hs-forest);
        color: var(--hs-forest);
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-outline:hover {
            background: var(--hs-forest);
            color: #FBF7F0;
        }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: var(--hs-forest-deep);
        }

    .btn-hs-ghost {
        background: transparent;
        color: #8E928D;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-ghost:hover {
            color: #8C3A36;
        }
</style>

<div class="min-h-screen" style="background-color: #FBF7F0; color: #1A1F1B;">

    <!-- ✅ هدر صفحه -->
    <div class="border-b border-[#E3DCC9] py-20">
        <div class="max-w-[1440px] mx-auto px-6 md:px-12">
            <h1 class="hs-display text-4xl md:text-5xl text-[#1A1F1B]">
                <i class="far fa-heart text-[#C2A878] text-3xl ml-4"></i>
                علاقه‌مندی‌ها
            </h1>
            <p class="hs-sans text-lg text-[#5C625C] mt-2">
                @Model.Count() اثر در لیست علاقه‌مندی‌های شما
            </p>
        </div>
    </div>

    <!-- ✅ لیست علاقه‌مندی‌ها -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-16">
        @if (!Model.Any())
        {
            <div class="text-center py-24">
                <i class="far fa-heart text-6xl text-[#C2A878] block mb-6 opacity-30"></i>
                <h3 class="hs-display text-3xl text-[#1A1F1B] mb-4">لیست علاقه‌مندی‌ها خالی است</h3>
                <p class="hs-sans text-[#5C625C] mb-8">هنوز اثری به علاقه‌مندی‌های خود اضافه نکرده‌اید.</p>
                <a asp-action="Index" asp-controller="Product" class="btn-hs-primary px-8 py-3 text-sm inline-block">
                    <i class="fas fa-arrow-right ml-2"></i> کشف آثار
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var item in Model)
                {
                    <div class="hs-card group overflow-hidden">
                        <!-- تصویر -->
                        <div class="relative aspect-[4/3] overflow-hidden bg-[#ECE4D2]">
                            <img src="@(item.ProductImage ?? "/images/no-image.png")"
                                 class="w-full h-full object-cover group-hover:scale-[1.02] hs-transition duration-[480ms]"
                                 alt="@item.ProductName" />
                            <button class="absolute top-3 left-3 text-[#8C3A36] hover:text-[#991B1B] hs-transition remove-wishlist"
                                    data-product-id="@item.ProductId"
                                    title="حذف از علاقه‌مندی‌ها">
                                <i class="fas fa-heart text-xl"></i>
                            </button>
                            @if (!item.IsInStock)
                            {
                                <div class="absolute inset-0 bg-black/20 flex items-center justify-center">
                                    <span class="hs-sans hs-uppercase text-xs px-4 py-2 bg-white/90 text-[#1A1F1B] rounded-full">
                                        ناموجود
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- اطلاعات -->
                        <div class="p-5">
                            <a asp-action="Details" asp-controller="Product" asp-route-slug="@item.Slug"
                               class="hs-display text-xl text-[#1A1F1B] hover:text-[#1F3D2E] hs-transition block">
                                @item.ProductName
                            </a>

                            <div class="flex items-end justify-between mt-3 pt-3 border-t border-[#E3DCC9]">
                                <div>
                                    @if (item.DiscountPercentage.HasValue && item.DiscountPercentage > 0)
                                    {
                                        <p class="hs-sans text-lg font-semibold tabular-nums text-[#1F3D2E]">
                                            @item.FinalPrice.ToString("N0") <span class="text-xs font-normal text-[#5C625C]">تومان</span>
                                        </p>
                                        <p class="hs-sans text-xs tabular-nums text-[#8E928D] line-through">
                                            @item.Price.ToString("N0")
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="hs-sans text-lg font-semibold tabular-nums text-[#1F3D2E]">
                                            @item.FinalPrice.ToString("N0") <span class="text-xs font-normal text-[#5C625C]">تومان</span>
                                        </p>
                                    }
                                </div>
                                <span class="hs-sans text-xs text-[#8E928D]">
                                    افزوده شده در @item.AddedAt.ToString("yyyy/MM/dd")
                                </span>
                            </div>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="px-5 pb-5 space-y-2">
                            <a asp-action="Details" asp-controller="Product" asp-route-slug="@item.Slug"
                               class="btn-hs-outline w-full py-2.5 text-xs block text-center">
                                <i class="fas fa-eye ml-1"></i> مشاهده جزئیات
                            </a>
                            @if (item.IsInStock)
                            {
                                <button class="btn-hs-primary w-full py-2.5 text-xs add-to-cart-btn"
                                        data-product-id="@item.ProductId">
                                    <i class="fas fa-shopping-bag ml-1"></i> افزودن به کلکسیون
                                </button>
                            }
                            else
                            {
                                <button class="w-full py-2.5 border border-[#E3DCC9] text-[#8E928D] hs-sans text-xs uppercase tracking-[0.12em] rounded-[2px] cursor-not-allowed">
                                    <i class="fas fa-exclamation-circle ml-1"></i> ناموجود
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- دکمه خالی کردن لیست -->
            <div class="text-center mt-16 pt-8 border-t border-[#E3DCC9]">
                <form asp-action="Clear" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-hs-ghost text-sm px-6 py-2"
                            onclick="return confirm('آیا از خالی کردن لیست علاقه‌مندی‌ها اطمینان دارید؟')">
                        <i class="fas fa-trash-alt ml-1"></i> خالی کردن لیست
                    </button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // حذف از علاقه‌مندی‌ها (AJAX)
        document.querySelectorAll('.remove-wishlist').forEach(btn => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();
                const productId = this.dataset.productId;
                const card = this.closest('.hs-card');

                try {
                    const response = await fetch(`/Wishlist/Remove?productId=${productId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    });

                    const result = await response.json();
                    if (result.success) {
                        // حذف کارت از DOM
                        if (card) {
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                card.remove();
                                // به‌روزرسانی تعداد
                                updateWishlistWidget();
                                // اگر لیست خالی شد، صفحه را رفرش کن
                                if (document.querySelectorAll('.hs-card').length === 0) {
                                    location.reload();
                                }
                            }, 320);
                        }
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert('خطا در ارتباط با سرور');
                }
            });
        });

        // افزودن به سبد خرید با AJAX
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const productId = this.dataset.productId;
                const originalText = this.innerText;
                this.innerHTML = '<span class="inline-block animate-spin">⟳</span>';
                this.disabled = true;
                this.style.opacity = '0.7';

                try {
                    const response = await fetch('/Cart/AddToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ productId: productId, quantity: 1 })
                    });

                    const result = await response.json();
                    if (result.success) {
                        if (typeof updateCartWidget === 'function') updateCartWidget();
                        this.innerHTML = '✓ افزوده شد';
                        this.style.backgroundColor = '#4A7C59';
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.style.backgroundColor = '';
                            this.disabled = false;
                            this.style.opacity = '1';
                        }, 2000);
                    } else {
                        alert(result.message);
                        this.innerHTML = originalText;
                        this.disabled = false;
                        this.style.opacity = '1';
                    }
                } catch (error) {
                    alert('خطا در ارتباط با سرور');
                    this.innerHTML = originalText;
                    this.disabled = false;
                    this.style.opacity = '1';
                }
            });
        });

        // به‌روزرسانی ویجت‌ها
        async function updateCartWidget() {
            try {
                const response = await fetch('/Cart/CartWidget');
                const data = await response.json();
                document.querySelector('#cart-item-count').textContent = data.itemCount;
                document.querySelector('#cart-total').textContent = data.total;
            } catch (error) {
                console.error('Error updating cart widget:', error);
            }
        }

        async function updateWishlistWidget() {
            try {
                const response = await fetch('/Wishlist/Count');
                const data = await response.json();
                document.querySelector('#wishlist-count').textContent = data.count;
            } catch (error) {
                console.error('Error updating wishlist widget:', error);
            }
        }
    </script>
}