@using JewelryStore.Services.DTOs.Order
@using JewelryStore.Domain.Enums
@model IEnumerable<OrderDetailDto>
@{
    ViewData["Title"] = "تاریخچه سفارشات";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-ink-subtle: #8E928D;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-card {
        background: #FFFFFF;
        border: 1px solid var(--hs-outline);
        border-radius: 4px;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-family: var(--hs-sans);
    }

    .status-pending {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-paid {
        background: #DCFCE7;
        color: #166534;
    }

    .status-processing {
        background: #E0E7FF;
        color: #3730A3;
    }

    .status-shipped {
        background: #E0E7FF;
        color: #3730A3;
    }

    .status-delivered {
        background: #DCFCE7;
        color: #166534;
    }

    .status-cancelled {
        background: #FEE2E2;
        color: #991B1B;
    }

    .status-returned {
        background: #FEE2E2;
        color: #991B1B;
    }
</style>

<div class="min-h-screen" style="background-color: #FBF7F0; color: #1A1F1B;">

    <!-- ✅ هدر صفحه -->
    <div class="border-b border-[#E3DCC9] py-20">
        <div class="max-w-[1440px] mx-auto px-6 md:px-12">
            <h1 class="hs-display text-4xl md:text-5xl text-[#1A1F1B]">
                <i class="fas fa-receipt text-[#C2A878] text-3xl ml-4"></i>
                تاریخچه سفارشات
            </h1>
            <p class="hs-sans text-lg text-[#5C625C] mt-2">
                @Model.Count() سفارش ثبت شده
            </p>
        </div>
    </div>

    <!-- ✅ لیست سفارشات -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-16">
        @if (!Model.Any())
        {
            <div class="text-center py-24">
                <i class="fas fa-receipt text-6xl text-[#C2A878] block mb-6 opacity-30"></i>
                <h3 class="hs-display text-3xl text-[#1A1F1B] mb-4">هنوز سفارشی ثبت نکرده‌اید</h3>
                <p class="hs-sans text-[#5C625C] mb-8">کلکسیون خود را تکمیل کنید و اولین سفارش خود را ثبت کنید.</p>
                <a asp-action="Index" asp-controller="Product" class="px-8 py-3 bg-[#1F3D2E] text-[#FBF7F0] rounded-[2px] text-sm uppercase tracking-[0.12em] hover:bg-[#142A1F] transition-all inline-block">
                    <i class="fas fa-arrow-right ml-2"></i> کشف آثار
                </a>
            </div>
        }
        else
        {
            <div class="space-y-6">
                @foreach (var order in Model)
                {
                    <div class="hs-card overflow-hidden">
                        <div class="p-6">
                            <!-- هدر سفارش -->
                            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#E3DCC9]">
                                <div>
                                    <span class="hs-sans text-sm text-[#8E928D]">شماره سفارش</span>
                                    <p class="hs-sans font-mono text-sm font-semibold text-[#1A1F1B]">@order.OrderNumber</p>
                                </div>
                                <div>
                                    <span class="hs-sans text-sm text-[#8E928D]">تاریخ ثبت</span>
                                    <p class="hs-sans text-sm text-[#1A1F1B]">@order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
                                </div>
                                <div>
                                    <span class="hs-sans text-sm text-[#8E928D]">وضعیت</span>
                                    <span class="status-badge status-@(order.OrderStatus.ToString().ToLower())">
                                        @GetStatusName(order.OrderStatus)
                                    </span>
                                </div>
                                <div>
                                    <span class="hs-sans text-sm text-[#8E928D]">مبلغ</span>
                                    <p class="hs-sans font-semibold text-[#1F3D2E] tabular-nums text-lg">
                                        @order.TotalAmount.ToString("N0") تومان
                                    </p>
                                </div>
                            </div>

                            <!-- آیتم‌های سفارش -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
                                @foreach (var item in order.Items.Take(4))
                                {
                                    <div class="flex items-center gap-3">
                                        <img src="@(item.ProductImage ?? "/images/no-image.png")"
                                             class="w-12 h-12 object-cover border border-[#E3DCC9]" />
                                        <div>
                                            <p class="hs-sans text-sm text-[#1A1F1B] line-clamp-1">@item.ProductName</p>
                                            <p class="hs-sans text-xs text-[#8E928D]">@item.Quantity × @item.FinalUnitPrice.ToString("N0")</p>
                                        </div>
                                    </div>
                                }
                                @if (order.Items.Count > 4)
                                {
                                    <div class="flex items-center justify-center text-[#8E928D] hs-sans text-sm">
                                        +@(order.Items.Count - 4) اثر دیگر
                                    </div>
                                }
                            </div>

                            <!-- دکمه‌های عملیات -->
                            <div class="flex flex-wrap gap-3 mt-6 pt-4 border-t border-[#E3DCC9]">
                                <a asp-action="Details" asp-route-orderId="@order.Id"
                                   class="px-4 py-2 border border-[#1F3D2E] text-[#1F3D2E] rounded-[2px] text-xs uppercase tracking-[0.12em] hover:bg-[#1F3D2E] hover:text-[#FBF7F0] transition-all">
                                    <i class="fas fa-eye ml-1"></i> مشاهده جزئیات
                                </a>
                               
                                @if (order.OrderStatus == OrderStatus.Shipped && !string.IsNullOrEmpty(order.TrackingCode))
                                {
                                    <a asp-action="Tracking" asp-route-orderId="@order.Id"
                                       class="px-4 py-2 text-[#1F3D2E] text-xs uppercase tracking-[0.12em] hover:text-[#3D6650] transition-all">
                                        <i class="fas fa-truck ml-1"></i> پیگیری مرسوله
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@functions {
    private string GetStatusName(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "در انتظار پرداخت",
            OrderStatus.Paid => "پرداخت شده",
            OrderStatus.Processing => "در حال پردازش",
            OrderStatus.Shipped => "ارسال شده",
            OrderStatus.Delivered => "تحویل داده شده",
            OrderStatus.Cancelled => "لغو شده",
            OrderStatus.Returned => "مرجوع شده",
            _ => "نامشخص"
        };
    }
}