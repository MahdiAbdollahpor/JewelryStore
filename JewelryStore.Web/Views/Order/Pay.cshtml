@using JewelryStore.Services.DTOs.Order
@model OrderDetailDto
@{
    ViewData["Title"] = $"پرداخت سفارش {Model.OrderNumber}";
}

<style>
    :root {
        --hs-bg: #FBF7F0;
        --hs-forest: #1F3D2E;
        --hs-forest-deep: #142A1F;
        --hs-tan: #C2A878;
        --hs-ink: #1A1F1B;
        --hs-ink-muted: #5C625C;
        --hs-outline: #E3DCC9;
        --hs-display: 'Cormorant Garamond', 'IranNastaliq', serif;
        --hs-sans: 'Vazirmatn', 'Inter', sans-serif;
    }

    .hs-display {
        font-family: var(--hs-display);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .hs-sans {
        font-family: var(--hs-sans);
    }

    .hs-uppercase {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
    }

    .hs-transition {
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .hs-card {
        background: #FFFFFF;
        border: 1px solid var(--hs-outline);
        border-radius: 4px;
    }

    .btn-hs-primary {
        background: var(--hs-forest);
        color: #FBF7F0;
        border-radius: 2px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
        font-family: var(--hs-sans);
    }

        .btn-hs-primary:hover {
            background: var(--hs-forest-deep);
        }
</style>

<div class="min-h-screen flex items-center justify-center" style="background-color: #FBF7F0; padding: 48px 24px;">
    <div class="w-full max-w-lg">
        <!-- عنوان -->
        <div class="text-center mb-8">
            <h1 class="hs-display text-3xl text-[#1A1F1B]">پرداخت سفارش</h1>
            <p class="hs-sans text-[#5C625C] mt-2">شماره سفارش: <span class="font-mono font-medium">@Model.OrderNumber</span></p>
        </div>

        <!-- کارت پرداخت -->
        <div class="hs-card p-8">
            <div class="text-center mb-6">
                <div class="text-5xl text-[#C2A878] mb-4">
                    <i class="fas fa-credit-card"></i>
                </div>
                <p class="hs-sans text-[#5C625C]">مبلغ قابل پرداخت</p>
                <p class="hs-display text-4xl font-bold text-[#1F3D2E]">@Model.TotalAmount.ToString("N0") <span class="text-xl font-normal text-[#5C625C]">تومان</span></p>
            </div>

            <div class="space-y-4 mb-8">
                <div class="flex justify-between text-sm border-b border-[#E3DCC9] pb-2">
                    <span class="text-[#5C625C]">جمع کل</span>
                    <span>@Model.SubTotal.ToString("N0") تومان</span>
                </div>
                @if (Model.DiscountTotal > 0)
                {
                    <div class="flex justify-between text-sm text-[#16A34A] border-b border-[#E3DCC9] pb-2">
                        <span>تخفیف</span>
                        <span>-@Model.DiscountTotal.ToString("N0") تومان</span>
                    </div>
                }
                <div class="flex justify-between text-sm border-b border-[#E3DCC9] pb-2">
                    <span class="text-[#5C625C]">هزینه ارسال</span>
                    <span>@Model.ShippingCost.ToString("N0") تومان</span>
                </div>
                <div class="flex justify-between text-sm border-b border-[#E3DCC9] pb-2">
                    <span class="text-[#5C625C]">مالیات</span>
                    <span>@Model.TaxAmount.ToString("N0") تومان</span>
                </div>
                <div class="flex justify-between text-sm font-semibold pt-2">
                    <span class="text-[#1A1F1B]">قابل پرداخت</span>
                    <span class="text-[#1F3D2E]">@Model.TotalAmount.ToString("N0") تومان</span>
                </div>
            </div>

            <!-- دکمه پرداخت -->
            <a href="@ViewBag.PaymentUrl" class="btn-hs-primary w-full py-4 text-center block text-lg">
                <i class="fas fa-credit-card ml-2"></i> پرداخت
            </a>

            <p class="hs-sans text-xs text-[#5C625C] text-center mt-4">
                پس از پرداخت، سفارش شما در اسرع وقت آماده و ارسال خواهد شد.
            </p>
        </div>

        <!-- لینک بازگشت -->
        <div class="text-center mt-6">
            <a asp-action="Details" asp-route-orderId="@Model.Id" class="hs-sans text-sm text-[#5C625C] hover:text-[#1F3D2E] hs-transition">
                <i class="fas fa-arrow-right ml-1"></i> بازگشت به جزئیات سفارش
            </a>
        </div>
    </div>
</div>