@using JewelryStore.Services.DTOs.Admin
@using JewelryStore.Domain.Enums
@model IEnumerable<DiscountListDto>
@{
    ViewData["Title"] = "مدیریت تخفیف‌ها";
}

<style>
    :root {
        --es-primary: #C2410C;
        --es-surface: #F5F5F4;
        --es-surface-raised: #E7E5E4;
        --es-border: #D6D3D1;
        --es-text-primary: #1C1917;
        --es-text-secondary: #57534E;
    }

    .table-container {
        background: var(--es-surface);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        overflow: hidden;
    }

        .table-container th {
            background: var(--es-surface-raised);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--es-text-secondary);
            padding: 12px 16px;
            text-align: right;
            font-weight: 600;
        }

        .table-container td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--es-border);
            font-size: 14px;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-active {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .status-inactive {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }
</style>

<div class="space-y-6">
    <!-- هدر -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">مدیریت تخفیف‌ها</h1>
            <p class="text-[#57534E] mt-1">@Model.Count() کد تخفیف</p>
        </div>
        <a asp-action="Create" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition flex items-center gap-2">
            <i class="fas fa-plus"></i> کد تخفیف جدید
        </a>
    </div>

    <!-- فیلتر -->
    <div class="bg-[#F5F5F4] border border-[#D6D3D1] rounded-xl p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">جستجو</label>
                <input type="text" name="SearchTerm" value="@ViewBag.CurrentFilter?.SearchTerm"
                       class="w-48 px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]"
                       placeholder="کد یا عنوان..." />
            </div>
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">وضعیت</label>
                <select name="IsActive" class="px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]">
                    <option value="">همه</option>
                    <option value="true" selected="@(ViewBag.CurrentFilter?.IsActive == true)">فعال</option>
                    <option value="false" selected="@(ViewBag.CurrentFilter?.IsActive == false)">غیرفعال</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition">
                <i class="fas fa-search ml-1"></i> فیلتر
            </button>
        </form>
    </div>

    <!-- جدول -->
    <div class="table-container">
        <table class="w-full">
            <thead>
                <tr>
                    <th>کد</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>مقدار</th>
                    <th>استفاده شده</th>
                    <th>انقضا</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var discount in Model)
                {
                    <tr class="hover:bg-[#E7E5E4]/50 transition">
                        <td class="font-mono text-sm font-medium text-[#1C1917]">@discount.Code</td>
                        <td>@discount.Title</td>
                        <td>@(discount.DiscountType == DiscountType.Percentage ? "درصدی" : "مبلغ ثابت")</td>
                        <td>@discount.DiscountValue.ToString("N0")</td>
                        <td>@discount.UsedCount @(discount.UsageLimit.HasValue ? $"/ {discount.UsageLimit}" : "")</td>
                        <td class="text-[#57534E] text-sm">@(discount.EndDate?.ToString("yyyy/MM/dd") ?? "نامحدود")</td>
                        <td>
                            <span class="status-badge @(discount.IsActive ? "status-active" : "status-inactive")">
                                @(discount.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <form asp-action="ToggleStatus" asp-route-id="@discount.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                        <i class="fas @(discount.IsActive ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@discount.Id" method="post" class="inline"
                                      onsubmit="return confirm('آیا از حذف این کد تخفیف اطمینان دارید؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-red-50 hover:border-red-200 transition text-red-600">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-[#57534E] py-12">
                            <i class="fas fa-tag text-2xl block mb-2 opacity-30"></i>
                            هیچ کد تخفیفی یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>