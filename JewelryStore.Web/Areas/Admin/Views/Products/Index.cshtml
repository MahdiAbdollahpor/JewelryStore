@using JewelryStore.Services.DTOs.Product
@model IEnumerable<ProductListDto>
@{
    ViewData["Title"] = "مدیریت محصولات";
}

<style>
    :root {
        --es-primary: #C2410C;
        --es-surface: #F5F5F4;
        --es-surface-raised: #E7E5E4;
        --es-border: #D6D3D1;
        --es-text-primary: #1C1917;
        --es-text-secondary: #57534E;
        --es-success: #16A34A;
        --es-error: #DC2626;
    }

    .table-container {
        background: var(--es-surface);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        overflow: hidden;
    }

        .table-container th {
            background: var(--es-surface-raised);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--es-text-secondary);
            padding: 12px 16px;
            text-align: right;
            font-weight: 600;
        }

        .table-container td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--es-border);
            font-size: 14px;
        }

        .table-container tr:last-child td {
            border-bottom: none;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-active {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .status-inactive {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }

    .status-instock {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .status-outofstock {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }

    .product-image {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--es-border);
    }
</style>

<div class="space-y-6">
    <!-- هدر -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">مدیریت محصولات</h1>
            <p class="text-[#57534E] mt-1">@Model.Count() محصول</p>
        </div>
        <a asp-action="Create" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition flex items-center gap-2">
            <i class="fas fa-plus"></i> محصول جدید
        </a>
    </div>

    <!-- فیلتر -->
    <div class="bg-[#F5F5F4] border border-[#D6D3D1] rounded-xl p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">جستجو</label>
                <input type="text" name="SearchTerm" value="@ViewBag.CurrentFilter?.SearchTerm"
                       class="w-48 px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]"
                       placeholder="نام محصول..." />
            </div>
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">وضعیت</label>
                <select name="IsActive" class="px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]">
                    <option value="">همه</option>
                    <option value="true" selected="@(ViewBag.CurrentFilter?.IsActive == true)">فعال</option>
                    <option value="false" selected="@(ViewBag.CurrentFilter?.IsActive == false)">غیرفعال</option>
                </select>
            </div>
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">موجودی</label>
                <select name="IsInStock" class="px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]">
                    <option value="">همه</option>
                    <option value="true" selected="@(ViewBag.CurrentFilter?.IsInStock == true)">موجود</option>
                    <option value="false" selected="@(ViewBag.CurrentFilter?.IsInStock == false)">ناموجود</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition">
                <i class="fas fa-search ml-1"></i> فیلتر
            </button>
            <a asp-action="Index" class="px-4 py-2 border border-[#D6D3D1] rounded-lg text-sm font-semibold text-[#57534E] hover:bg-[#E7E5E4] transition">
                <i class="fas fa-times ml-1"></i> پاک کردن
            </a>
        </form>
    </div>

    <!-- جدول -->
    <div class="table-container">
        <table class="w-full">
            <thead>
                <tr>
                    <th>تصویر</th>
                    <th>نام محصول</th>
                    <th>قیمت</th>
                    <th>موجودی</th>
                    <th>وضعیت</th>
                    <th>ویژه</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr class="hover:bg-[#E7E5E4]/50 transition">
                        <td>
                            <img src="@(product.MainImageUrl ?? "/images/no-image.png")"
                                 class="product-image" alt="@product.Name" />
                        </td>
                        <td class="font-medium text-[#1C1917]">@product.Name</td>
                        <td class="font-semibold text-[#1C1917]">@product.FinalPrice.ToString("N0") تومان</td>
                        <td>
                            <span class="status-badge @(product.IsInStock ? "status-instock" : "status-outofstock")">
                                @(product.IsInStock ? "موجود" : "ناموجود")
                            </span>
                        </td>
                     @*    <td>
                            <span class="status-badge @(product.IsActive ? "status-active" : "status-inactive")">
                                @(product.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td> *@
                        <td>
                            @if (product.IsFeatured)
                            {
                                <span class="text-[#F59E0B]"><i class="fas fa-star"></i></span>
                            }
                            else
                            {
                                <span class="text-[#D6D3D1]"><i class="far fa-star"></i></span>
                            }
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <a asp-action="Detail" asp-route-id="@product.Id"
                                   class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@product.Id"
                                   class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                    <i class="fas fa-edit"></i>
                                </a>
                               @*  <form asp-action="ToggleStatus" asp-route-id="@product.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                        <i class="fas @(product.IsActive ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                </form> *@
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-[#57534E] py-12">
                            <i class="fas fa-gem text-2xl block mb-2 opacity-30"></i>
                            هیچ محصولی یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>