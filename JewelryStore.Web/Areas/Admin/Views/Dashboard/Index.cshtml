@using JewelryStore.Services.DTOs.Report
@model DashboardStatisticsDto
@{
    ViewData["Title"] = "داشبورد";
}

<!-- ✅ کد کامل داشبورد (همان کد قبلی) -->
<div class="space-y-8">
    <!-- هدر -->
    <div>
        <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">داشبورد</h1>
        <p class="text-[#57534E] mt-1">خلاصه عملکرد فروشگاه</p>
    </div>

    <!-- آمار -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center gap-3">
                <div class="stat-icon stat-icon-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <p class="text-xs text-[#57534E] uppercase tracking-wider">کاربران</p>
                    <p class="stat-number">@Model.TotalUsers</p>
                </div>
            </div>
            <p class="text-xs text-[#57534E] mt-2">
                <i class="fas fa-plus-circle text-[#16A34A]"></i> @Model.NewUsersToday امروز
            </p>
        </div>

        <div class="stat-card">
            <div class="flex items-center gap-3">
                <div class="stat-icon stat-icon-accent">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div>
                    <p class="text-xs text-[#57534E] uppercase tracking-wider">سفارشات</p>
                    <p class="stat-number">@Model.TotalOrders</p>
                </div>
            </div>
            <p class="text-xs text-[#57534E] mt-2">
                <i class="fas fa-clock text-[#D97706]"></i> @Model.PendingOrders در انتظار
            </p>
        </div>

        <div class="stat-card">
            <div class="flex items-center gap-3">
                <div class="stat-icon stat-icon-success">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div>
                    <p class="text-xs text-[#57534E] uppercase tracking-wider">درآمد</p>
                    <p class="stat-number">@Model.TotalRevenue.ToString("N0")</p>
                </div>
            </div>
            <p class="text-xs text-[#57534E] mt-2">
                <i class="fas fa-chart-line text-[#16A34A]"></i> @Model.RevenueToday.ToString("N0") امروز
            </p>
        </div>

        <div class="stat-card">
            <div class="flex items-center gap-3">
                <div class="stat-icon stat-icon-primary">
                    <i class="fas fa-gem"></i>
                </div>
                <div>
                    <p class="text-xs text-[#57534E] uppercase tracking-wider">محصولات</p>
                    <p class="stat-number">@Model.TotalProducts</p>
                </div>
            </div>
            <p class="text-xs text-[#57534E] mt-2">
                <i class="fas fa-exclamation-triangle text-[#DC2626]"></i> @Model.OutOfStockProducts ناموجود
            </p>
        </div>
    </div>
</div>

<style>
    :root {
        --es-primary: #C2410C;
        --es-accent: #F59E0B;
        --es-success: #16A34A;
    }

    .stat-card {
        background: #F5F5F4;
        border: 1px solid #D6D3D1;
        border-radius: 12px;
        padding: 20px;
        transition: all 150ms ease;
    }

        .stat-card:hover {
            box-shadow: 0 4px 16px rgba(28, 25, 23, 0.06);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-icon-primary {
        background: rgba(194, 65, 12, 0.1);
        color: var(--es-primary);
    }

    .stat-icon-accent {
        background: rgba(245, 158, 11, 0.1);
        color: var(--es-accent);
    }

    .stat-icon-success {
        background: rgba(22, 163, 74, 0.1);
        color: var(--es-success);
    }

    .stat-number {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        font-weight: 700;
        color: #1C1917;
        letter-spacing: -0.02em;
    }
</style>