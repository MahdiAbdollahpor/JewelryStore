@using JewelryStore.Services.DTOs.Admin
@using JewelryStore.Domain.Enums
@model IEnumerable<OrderListDto>
@{
    ViewData["Title"] = "مدیریت سفارشات";
}

<style>
    :root {
        --es-primary: #C2410C;
        --es-surface: #F5F5F4;
        --es-surface-raised: #E7E5E4;
        --es-border: #D6D3D1;
        --es-text-primary: #1C1917;
        --es-text-secondary: #57534E;
    }

    .table-container {
        background: var(--es-surface);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        overflow: hidden;
    }

        .table-container th {
            background: var(--es-surface-raised);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--es-text-secondary);
            padding: 12px 16px;
            text-align: right;
            font-weight: 600;
        }

        .table-container td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--es-border);
            font-size: 14px;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.1);
        color: #D97706;
    }

    .status-paid {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .status-processing {
        background: rgba(194, 65, 12, 0.1);
        color: #C2410C;
    }

    .status-shipped {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .status-delivered {
        background: rgba(22, 163, 74, 0.15);
        color: #16A34A;
    }

    .status-cancelled {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }

    .status-returned {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }
</style>

<div class="space-y-6">
    <!-- هدر -->
    <div>
        <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">مدیریت سفارشات</h1>
        <p class="text-[#57534E] mt-1">@Model.Count() سفارش</p>
    </div>

    <!-- فیلتر -->
    <div class="bg-[#F5F5F4] border border-[#D6D3D1] rounded-xl p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">وضعیت</label>
                <select name="OrderStatus" class="px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]">
                    <option value="">همه</option>
                    @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@status" selected="@(ViewBag.CurrentFilter?.OrderStatus == status)">@GetStatusName(status)</option>
                    }
                </select>
            </div>
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">جستجو</label>
                <input type="text" name="SearchTerm" value="@ViewBag.CurrentFilter?.SearchTerm"
                       class="w-48 px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]"
                       placeholder="شماره سفارش، مشتری..." />
            </div>
            <button type="submit" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition">
                <i class="fas fa-search ml-1"></i> فیلتر
            </button>
        </form>
    </div>

    <!-- جدول -->
    <div class="table-container">
        <table class="w-full">
            <thead>
                <tr>
                    <th>شماره سفارش</th>
                    <th>مشتری</th>
                    <th>مبلغ</th>
                    <th>تعداد</th>
                    <th>وضعیت</th>
                    <th>پرداخت</th>
                    <th>تاریخ</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr class="hover:bg-[#E7E5E4]/50 transition">
                        <td class="font-mono text-sm font-medium text-[#1C1917]">@order.OrderNumber</td>
                        <td>@order.CustomerName</td>
                        <td class="font-semibold">@order.TotalAmount.ToString("N0") تومان</td>
                        <td class="text-[#57534E]">@order.ItemCount</td>
                        <td>
                            <span class="status-badge status-@(order.OrderStatus.ToString().ToLower())">
                                @GetStatusName(order.OrderStatus)
                            </span>
                        </td>
                        <td>
                            <span class="status-badge @(order.PaymentStatus == PaymentStatus.Paid ? "status-paid" : "status-pending")">
                                @(order.PaymentStatus == PaymentStatus.Paid ? "پرداخت شده" : "در انتظار")
                            </span>
                        </td>
                        <td class="text-[#57534E] text-sm">@order.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@order.Id"
                               class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition inline-block">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-[#57534E] py-12">
                            <i class="fas fa-receipt text-2xl block mb-2 opacity-30"></i>
                            هیچ سفارشی یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string GetStatusName(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "در انتظار پرداخت",
            OrderStatus.Paid => "پرداخت شده",
            OrderStatus.Processing => "در حال پردازش",
            OrderStatus.Shipped => "ارسال شده",
            OrderStatus.Delivered => "تحویل داده شده",
            OrderStatus.Cancelled => "لغو شده",
            OrderStatus.Returned => "مرجوع شده",
            _ => "نامشخص"
        };
    }
}