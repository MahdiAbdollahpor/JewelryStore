@using JewelryStore.Services.DTOs.User
@model IEnumerable<UserListDto>
@{
    ViewData["Title"] = "مدیریت کاربران";
}

<!-- ✅ کد کامل مدیریت کاربران (همان کد قبلی) -->
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">مدیریت کاربران</h1>
            <p class="text-[#57534E] mt-1">@ViewBag.TotalCount کاربر</p>
        </div>
        <a asp-action="Create" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition flex items-center gap-2">
            <i class="fas fa-user-plus"></i> کاربر جدید
        </a>
    </div>

   

    <!-- فیلتر -->
    <div class="bg-[#F5F5F4] border border-[#D6D3D1] rounded-xl p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[200px]">
                <label class="text-xs font-semibold text-[#57534E] block mb-1">جستجو</label>
                <input type="text" name="SearchTerm" value="@ViewBag.CurrentFilter?.SearchTerm"
                       class="w-full px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]"
                       placeholder="نام، شماره..." />
            </div>
            <div>
                <label class="text-xs font-semibold text-[#57534E] block mb-1">نقش</label>
                <select name="Role" class="px-3 py-2 border border-[#D6D3D1] rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C2410C]/20 focus:border-[#C2410C]">
                    <option value="">همه</option>
                    <option value="User" selected="@(ViewBag.CurrentFilter?.Role == "User")">کاربر</option>
                    <option value="Admin" selected="@(ViewBag.CurrentFilter?.Role == "Admin")">ادمین</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition">
                <i class="fas fa-search ml-1"></i> جستجو
            </button>
        </form>
    </div>

    <!-- جدول -->
    <div class="bg-[#F5F5F4] border border-[#D6D3D1] rounded-xl overflow-hidden">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="bg-[#E7E5E4] text-right px-4 py-3 text-xs uppercase tracking-wider text-[#57534E]">نام کاربری</th>
                    <th class="bg-[#E7E5E4] text-right px-4 py-3 text-xs uppercase tracking-wider text-[#57534E]">شماره تماس</th>
                    <th class="bg-[#E7E5E4] text-right px-4 py-3 text-xs uppercase tracking-wider text-[#57534E]">نقش</th>
                    <th class="bg-[#E7E5E4] text-right px-4 py-3 text-xs uppercase tracking-wider text-[#57534E]">وضعیت</th>
                    <th class="bg-[#E7E5E4] text-right px-4 py-3 text-xs uppercase tracking-wider text-[#57534E]">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-[#E7E5E4]/50 transition border-b border-[#D6D3D1]">
                        <td class="px-4 py-3 font-medium text-[#1C1917]"> @user.Username @user.FullName </td>
                        <td class="px-4 py-3 text-[#57534E]">@user.PhoneNumber</td>
                        <td class="px-4 py-3"><span class="text-xs font-semibold">@user.Role</span></td>
                        <td class="px-4 py-3">
                            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold @(user.IsActive ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                @(user.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <a asp-action="Detail" asp-route-id="@user.Id" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                        <i class="fas @(user.IsActive ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- ✅ صفحه‌بندی -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex flex-wrap justify-center items-center gap-2 mt-6 pt-6 border-t border-[#D6D3D1]">
            <!-- دکمه قبلی -->
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-SearchTerm="@ViewBag.CurrentFilter?.SearchTerm"
                   asp-route-CategoryId="@ViewBag.CurrentFilter?.CategoryId"
                   asp-route-IsActive="@ViewBag.CurrentFilter?.IsActive"
                   asp-route-IsInStock="@ViewBag.CurrentFilter?.IsInStock"
                   class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm hover:bg-[#E7E5E4] transition">
                    قبلی
                </a>
            }
            else
            {
                <span class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm text-[#57534E] cursor-not-allowed">قبلی</span>
            }

            <!-- شماره صفحات -->
            @{
                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                if (startPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-SearchTerm="@ViewBag.CurrentFilter?.SearchTerm"
                       asp-route-CategoryId="@ViewBag.CurrentFilter?.CategoryId"
                       asp-route-IsActive="@ViewBag.CurrentFilter?.IsActive"
                       asp-route-IsInStock="@ViewBag.CurrentFilter?.IsInStock"
                       class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm hover:bg-[#E7E5E4] transition">
                        1
                    </a>
                    if (startPage > 2)
                    {
                        <span class="px-3 py-1 text-[#57534E]">…</span>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    var isActive = i == ViewBag.CurrentPage;
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-SearchTerm="@ViewBag.CurrentFilter?.SearchTerm"
                       asp-route-CategoryId="@ViewBag.CurrentFilter?.CategoryId"
                       asp-route-IsActive="@ViewBag.CurrentFilter?.IsActive"
                       asp-route-IsInStock="@ViewBag.CurrentFilter?.IsInStock"
                       class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm transition @(isActive ? "bg-[#C2410C] text-white border-[#C2410C]" : "hover:bg-[#E7E5E4]")">
                        @i
                    </a>
                }

                if (endPage < ViewBag.TotalPages)
                {
                    if (endPage < ViewBag.TotalPages - 1)
                    {
                        <span class="px-3 py-1 text-[#57534E]">…</span>
                    }
                    <a asp-action="Index"
                       asp-route-page="@ViewBag.TotalPages"
                       asp-route-SearchTerm="@ViewBag.CurrentFilter?.SearchTerm"
                       asp-route-CategoryId="@ViewBag.CurrentFilter?.CategoryId"
                       asp-route-IsActive="@ViewBag.CurrentFilter?.IsActive"
                       asp-route-IsInStock="@ViewBag.CurrentFilter?.IsInStock"
                       class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm hover:bg-[#E7E5E4] transition">
                        @ViewBag.TotalPages
                    </a>
                }
            }

            <!-- دکمه بعدی -->
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-SearchTerm="@ViewBag.CurrentFilter?.SearchTerm"
                   asp-route-CategoryId="@ViewBag.CurrentFilter?.CategoryId"
                   asp-route-IsActive="@ViewBag.CurrentFilter?.IsActive"
                   asp-route-IsInStock="@ViewBag.CurrentFilter?.IsInStock"
                   class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm hover:bg-[#E7E5E4] transition">
                    بعدی
                </a>
            }
            else
            {
                <span class="px-3 py-1 border border-[#D6D3D1] rounded-lg text-sm text-[#57534E] cursor-not-allowed">بعدی</span>
            }
        </div>
    }
</div>