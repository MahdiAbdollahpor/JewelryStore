@using JewelryStore.Services.DTOs.Category
@model IEnumerable<CategoryAttributeDto>
@{
    ViewData["Title"] = "مدیریت ویژگی‌ها";
}

<style>
    :root {
        --es-primary: #C2410C;
        --es-surface: #F5F5F4;
        --es-surface-raised: #E7E5E4;
        --es-border: #D6D3D1;
    }

    .table-container {
        background: var(--es-surface);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        overflow: hidden;
    }

        .table-container th {
            background: var(--es-surface-raised);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #57534E;
            padding: 12px 16px;
            text-align: right;
            font-weight: 600;
        }

        .table-container td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--es-border);
            font-size: 14px;
        }

        .table-container tr:last-child td {
            border-bottom: none;
        }

    .badge {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .badge-active {
        background: rgba(22, 163, 74, 0.1);
        color: #16A34A;
    }

    .badge-inactive {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }

    .badge-filterable {
        background: rgba(194, 65, 12, 0.1);
        color: #C2410C;
    }
</style>

<div class="space-y-6">
    <!-- هدر -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-['Playfair_Display'] text-3xl font-bold text-[#1C1917]">مدیریت ویژگی‌ها</h1>
            <p class="text-[#57534E] mt-1">@Model.Count() ویژگی</p>
        </div>
        <a asp-action="Create" class="px-4 py-2 bg-[#C2410C] text-white rounded-lg text-sm font-semibold hover:bg-[#9A3412] transition flex items-center gap-2">
            <i class="fas fa-plus"></i> ویژگی جدید
        </a>
    </div>

    <!-- جدول -->
    <div class="table-container">
        <table class="w-full">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>دسته‌بندی</th>
                    <th>نوع</th>
                    <th>قابل فیلتر</th>
                    <th>اجباری</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attr in Model)
                {
                    <tr class="hover:bg-[#E7E5E4]/50 transition">
                        <td class="font-medium text-[#1C1917]">@attr.Name</td>
                        <td class="text-[#57534E]">@attr.CategoryName</td>
                        <td class="text-[#57534E]">@GetAttributeTypeName(attr.Type)</td>
                        <td>
                            <span class="badge @(attr.IsFilterable ? "badge-filterable" : "badge-inactive")">
                                @(attr.IsFilterable ? "بله" : "خیر")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(attr.IsRequired ? "badge-filterable" : "badge-inactive")">
                                @(attr.IsRequired ? "اجباری" : "اختیاری")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(attr.IsActive ? "badge-active" : "badge-inactive")">
                                @(attr.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@attr.Id"
                                   class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@attr.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-[#E7E5E4] transition">
                                        <i class="fas @(attr.IsActive ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@attr.Id" method="post" class="inline"
                                      onsubmit="return confirm('آیا از حذف این ویژگی اطمینان دارید؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 text-sm border border-[#D6D3D1] rounded-lg hover:bg-red-50 hover:border-red-200 transition text-red-600">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-[#57534E] py-12">
                            <i class="fas fa-list text-2xl block mb-2 opacity-30"></i>
                            هیچ ویژگی‌ای یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string GetAttributeTypeName(AttributeType type)
    {
        return type switch
        {
            AttributeType.String => "متن",
            AttributeType.Number => "عدد",
            AttributeType.Boolean => "بله/خیر",
            AttributeType.Color => "رنگ",
            AttributeType.Dropdown => "انتخابی",
            _ => "نامشخص"
        };
    }
}